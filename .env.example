# Rupkeep / Casco Bay Pilot Car - environment template (TASK-427)
#
# This file is PRODUCTION-SHAPED: copy it to .env on the host and fill in the
# blanks. Every key the code reads is listed; "REQUIRED" means the app is
# broken or unsafe without it on production. The "Required on production"
# table in docs/DEPLOYMENT.md is the checklist version of this file.
#
# For LOCAL DEVELOPMENT flip these after copying:
#   APP_ENV=local  APP_DEBUG=true  APP_URL=http://localhost
#   DB_CONNECTION=sqlite  MAIL_MAILER=log  SESSION_SECURE_COOKIE=false
#   LOG_STACK=single  DISPATCH_AUTO_CAPTURE=false

# ---------------------------------------------------------------- Application
APP_NAME="Casco Bay Pilot Car"
APP_ENV=production                  # REQUIRED: production. Also makes db:reset refuse to run.
APP_KEY=                            # REQUIRED: php artisan key:generate
APP_DEBUG=false                     # REQUIRED: false. true leaks config and stack traces to visitors.
APP_TIMEZONE=UTC                    # storage timezone; leave UTC
APP_DISPLAY_TIMEZONE=America/New_York   # what users see (pickup times etc.)
APP_URL=https://pilotcar.io         # REQUIRED: signed URLs, emails and login links are built from this

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# -------------------------------------------------------------------- Logging
LOG_CHANNEL=stack
LOG_STACK=daily                     # daily on production so one file cannot grow forever
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning                   # debug locally; warning or error on production

# ------------------------------------------------------------------- Database
DB_CONNECTION=mysql                 # REQUIRED on production (sqlite is for dev/tests only)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rupkeep
DB_USERNAME=rupkeep
DB_PASSWORD=                        # REQUIRED

# --------------------------------------------------- Session / cache / queue
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true          # REQUIRED on https: the session cookie is never sent over plain http
SANCTUM_STATEFUL_DOMAINS=pilotcar.io,www.pilotcar.io

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database           # a supervised `queue:work` must be running; see docs/DEPLOYMENT.md

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ------------------------------------------------------------ Mail (Brevo)
# Mail::send goes over Brevo's SMTP relay; SMS-gateway sends use the Brevo API.
MAIL_MAILER=brevo                   # REQUIRED on production (log locally)
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=                      # REQUIRED: Brevo SMTP login
MAIL_PASSWORD=                      # REQUIRED: Brevo SMTP key
BREVO_API_KEY=                      # REQUIRED for SMS-gateway notifications
MAIL_FROM_ADDRESS=                  # REQUIRED: must be a sender VERIFIED in Brevo or mail is rejected
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------- Passwordless login codes
LOGIN_CODE_EXPIRY_MINUTES=120
LOGIN_CODE_LENGTH=8

# ------------------------------------------------ Web push notifications
# REQUIRED in every environment; the push library throws "Unable to create the
# key" without them. Generate once: php artisan webpush:vapid (or the
# web-push CLI) and keep the private key out of git.
VAPID_SUBJECT=mailto:admin@pilotcar.io
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---------------------------------------------------- Fresh-install accounts
# Read by super:create and db:seed. SUPER_EMAIL is REQUIRED: without it a
# fresh install has no super user and every admin tool is unreachable.
SUPER_NAME=
SUPER_EMAIL=
SUPER_PASSWORD=
u1_email=                           # first seeded org admin (becomes organization owner)
u1_password=
u2_email=
u2_password=
default_password=                   # initial password for the other seeded staff accounts

# ------------------------------------------------------------ Public pricing
# Organization whose price list the public /pricing page shows. Leave blank to
# fall back to the organization named "Casco Bay Pilot Car".
PRICING_DEFAULT_ORGANIZATION_ID=

# ---------------------------------------------------------- Feature flags
FEATURE_INVOICE_PDF_DOWNLOADS=false # see docs/FEATURE_FLAGS.md

# -------------------------------------------------------------- Dispatch
DISPATCH_AUTO_CAPTURE=true          # production: open a triage bug task for every uncaught 500
# Dev machines only - lets `dispatch:pull/push` talk to production. Never set on the host.
DISPATCH_REMOTE_URL=
DISPATCH_REMOTE_TOKEN=
DISPATCH_REMOTE_TIMEOUT=30
DISPATCH_REMOTE_VERIFY_SSL=true

# ---------------------------------------------------------- Setup console
# /setup runs db:reset (migrate:fresh + reseed). Leave it OFF on production;
# when on it still needs a signed-in super user AND this password, and
# db:reset refuses on APP_ENV=production without --force-production.
SETUP_CONSOLE_ENABLED=false
SETUP_USERNAME=setup
SETUP_PASSWORD=

# ------------------------------------------------------------------- Unused
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
